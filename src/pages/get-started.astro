---
import Layout from '@/layouts/Layout.astro'
import NavigationCard from '@/components/navigation-card.astro'
import StartGuideSection from '@/components/start-guide-section.astro'
import { Gamepad2, Palette, Power, Wrench } from 'lucide-react'

const pathways = [
  {
    href: '#set-up',
    title: 'Set Up Your Badge',
    description: 'Charge, start and configure it',
    icon: Power,
  },
  {
    href: '#personalize',
    title: 'Personalize Your Badge',
    description: 'Profile, apps and menu images',
    icon: Palette,
  },
  {
    href: '#controls',
    title: 'Learn the Controls',
    description: 'Buttons, power and USB modes',
    icon: Gamepad2,
  },
  {
    href: '#troubleshooting',
    title: 'Troubleshooting',
    description: 'Fix startup and connection issues',
    icon: Wrench,
  },
]

const guides = [
  {
    id: 'set-up',
    title: 'Set Up Your Badge',
    description: 'Get MonaOS running, connect the badge, and confirm your profile works.',
    steps: [
      {
        title: 'Charge the battery',
        description: 'Connect USB-C power at 5 V. The CHG light on the back turns on while the battery is charging.',
        aliases: ['charging'],
      },
      {
        title: 'Start MonaOS',
        description: 'Press RESET on the back once. After the launch animation, press HOME once to open the app launcher.',
        aliases: ['power-on'],
      },
      {
        title: 'Configure Settings',
        description: 'Open Settings and enter a 2.4 GHz Wi-Fi network, your GitHub username, contact details, and preferred backlight level.',
        links: [
          { href: '/hack/connect-wifi/', label: 'Wi-Fi guide' },
          { href: '/hack/badge-custom-username/', label: 'Settings guide' },
        ],
      },
      {
        title: 'Verify the setup',
        description: 'Open the Badge app. Your avatar and contribution graph should load after the badge connects to Wi-Fi.',
      },
    ],
  },
  {
    id: 'personalize',
    title: 'Personalize Your Badge',
    description: 'Configure your identity, install apps, and change what appears in the launcher.',
    steps: [
      {
        title: 'Set your profile and contact details',
        description: 'Use Settings to enter your GitHub username, name, LinkedIn profile, Wi-Fi details, and backlight level.',
        links: [
          { href: '/hack/badge-custom-username/', label: 'Configure badge settings' },
        ],
      },
      {
        title: 'Install apps',
        description: 'Double-press RESET to mount the BADGER disk, open the App Store, choose apps, and upload them to the badge.',
        links: [
          { href: '/apps', label: 'Open App Store' },
        ],
      },
      {
        title: 'Add a photo tile',
        description: 'Convert a photo into a launcher tile and copy the generated app folder to your badge.',
        links: [
          { href: '/hack/gallery-import-image/', label: 'Add your photo' },
        ],
      },
      {
        title: 'Add an Octocanvas wallpaper',
        description: 'Turn an Octocanvas image into a launcher tile using the prepared image workflow.',
        links: [
          { href: '/hack/octocanvas-wallpaper/', label: 'Add a wallpaper' },
        ],
      },
    ],
  },
  {
    id: 'controls',
    title: 'Learn the Controls',
    description: 'Use the launcher, manage power, and choose the correct USB mode.',
    steps: [
      {
        title: 'Navigate apps',
        description: 'Use the directional controls to move through menus. Press Select to open an item and Back to return inside an app.',
      },
      {
        title: 'Return to the launcher',
        description: 'Press HOME on the back once to leave the current app and return to the MonaOS launcher.',
      },
      {
        title: 'Sleep or power off',
        description: 'Hold RESET for about three seconds to sleep. To power off, hold UP, DOWN, and RESET together for about three seconds.',
        aliases: ['sleep', 'power-off'],
      },
      {
        title: 'Open USB Disk Mode',
        description: 'Double-press RESET quickly. Wait for USB Disk Mode on the screen and a drive named BADGER on your computer.',
        aliases: ['usb-disk'],
      },
      {
        title: 'Recognize firmware mode',
        description: 'Holding HOME while tapping RESET mounts a drive named RP2350. Use that mode only when flashing firmware, not when installing apps.',
      },
    ],
  },
  {
    id: 'troubleshooting',
    title: 'Troubleshooting',
    description: 'Resolve the most common startup, USB, Wi-Fi, and firmware problems.',
    steps: [
      {
        title: 'The badge does not start',
        description: 'Connect USB-C power, wait for the CHG light, then press RESET once. Try a different cable or power source if the light stays off.',
      },
      {
        title: 'The BADGER drive does not appear',
        description: 'Confirm the cable transfers data, double-press RESET again, and select the BADGER drive root rather than its apps folder.',
      },
      {
        title: 'An RP2350 drive appears',
        description: 'Do not copy app files to it. Press RESET once to restart, then double-press RESET to enter USB Disk Mode.',
      },
      {
        title: 'Wi-Fi does not connect',
        description: 'Use a 2.4 GHz network and check that the network name and password match exactly, including capitalization.',
        links: [
          { href: '/hack/connect-wifi/', label: 'Check Wi-Fi setup' },
        ],
      },
      {
        title: 'Restore the firmware',
        description: 'Back up your badge files, download the newest UF2 release, enter RP2350 mode, and copy the UF2 file to that drive. Factory restoration images erase the badge filesystem.',
        aliases: ['flash'],
        links: [
          { href: 'https://github.com/badger/home/releases', label: 'Firmware releases', external: true },
        ],
      },
    ],
  },
]
---

<Layout title="Start Here / Badger" description="Set up, personalize, control, and troubleshoot the Badger 2350.">
  <section class="relative overflow-hidden border-b border-border/70 py-14 sm:py-16">
    <div class="grid-texture pointer-events-none absolute inset-0 opacity-30"></div>
    <div class="container relative">
      <p class="font-mono text-xs uppercase tracking-[0.16em] text-primary">Start Here</p>
      <h1 class="mt-4 max-w-2xl text-5xl leading-[0.98] sm:text-6xl">
        Get your badge <span class="text-primary">running.</span>
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-7 text-muted-foreground sm:text-lg">
        Set it up, personalize it, learn the controls, or fix a common problem.
      </p>

      <nav aria-label="Start Here sections" class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {pathways.map((pathway) => (
          <NavigationCard {...pathway} compact />
        ))}
      </nav>
    </div>
  </section>

  <section class="py-12 sm:py-16">
    <div class="container grid gap-6">
      {guides.map((guide, index) => (
        <StartGuideSection
          id={guide.id}
          number={index + 1}
          title={guide.title}
          description={guide.description}
          steps={guide.steps}
        />
      ))}
    </div>
  </section>
</Layout>
