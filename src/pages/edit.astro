---
const destination = '/apps'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="https://badger.github.io/apps" />
    <title>Apps moved | Badger</title>
    <script is:inline define:vars={{ destination }}>
      window.location.replace(`${destination}${window.location.search}${window.location.hash}`)
    </script>
  </head>
  <body>
    <p>Apps moved to <a href="/apps">/apps</a>.</p>
  </body>
</html>
