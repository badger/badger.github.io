---
import Layout from '@/layouts/Layout.astro'
import ListingHero from '@/components/listing-hero.astro'
import { BadgeManager } from '@/components/badge-manager'
---

<Layout title="App Store / Badger" description="Connect a Badger, install available apps, or upload a local app.">
  <ListingHero
    title="App Store"
    description="Connect your badge, choose apps from badger/home, or upload a local app folder."
    compact
  />
  <section class="py-8 sm:py-12">
    <div class="container">
      <BadgeManager client:load />
    </div>
  </section>
</Layout>
