---
import Layout from '@/layouts/Layout.astro'
import ListingHero from '@/components/listing-hero.astro'
import { HackListItem } from '@/components/hack-list-item'
import { getCollection } from 'astro:content'

const allHacks = await getCollection('hacks')
const sortedHacks = allHacks.sort((left, right) => new Date(right.data.date).getTime() - new Date(left.data.date).getTime())
const counts = {
  all: sortedHacks.length,
  beginner: sortedHacks.filter((hack) => hack.data.difficulty === 'beginner').length,
  intermediate: sortedHacks.filter((hack) => hack.data.difficulty === 'intermediate').length,
  advanced: sortedHacks.filter((hack) => hack.data.difficulty === 'advanced').length,
}
---

<Layout title="Hacks / Badger 2350" description="Practical hardware and software experiments for the Badger 2350.">
  <ListingHero
    eyebrow="// FIELD NOTES"
    description="Hardware and software notes for the Badger 2350. Filter by difficulty."
  />

  <section class="py-12 sm:py-16">
    <div class="container">
      <div class="grid gap-10 lg:grid-cols-[15rem_1fr]">
        <aside>
          <div class="surface sticky top-24 p-4">
            <div class="mb-3 px-2 font-mono text-[0.65rem] uppercase tracking-[0.16em] text-muted-foreground">Filter by level</div>
            <div id="filter-controls" class="grid gap-1">
              {(['all', 'beginner', 'intermediate', 'advanced'] as const).map((filter) => (
                <button type="button" class="filter-btn flex items-center justify-between rounded-md px-3 py-2.5 text-left text-sm text-muted-foreground transition-colors hover:bg-primary/5 hover:text-foreground data-[active=true]:bg-primary/10 data-[active=true]:text-primary" data-filter={filter} data-active={filter === 'all'}>
                  <span>{filter === 'all' ? 'All hacks' : filter}</span>
                  <span class="font-mono text-xs">{counts[filter]}</span>
                </button>
              ))}
            </div>
          </div>
        </aside>

        <div class="min-w-0">
          <div class="mb-5 flex items-center justify-between gap-4 border-b border-border/70 pb-4">
            <span class="font-mono text-xs uppercase tracking-[0.14em] text-muted-foreground">{sortedHacks.length} experiments</span>
            <span class="font-mono text-xs uppercase tracking-[0.14em] text-primary/70">newest first</span>
          </div>
          <div id="hacks-grid" class="grid gap-3">
            {sortedHacks.map((hack) => (
              <div class="hack-item" data-difficulty={hack.data.difficulty}>
                <HackListItem title={hack.data.title} description={hack.data.description} difficulty={hack.data.difficulty} duration={hack.data.duration} slug={hack.slug} client:load />
              </div>
            ))}
          </div>
          <div id="no-results" class="hidden py-16 text-center font-mono text-sm text-muted-foreground">No experiments at this level yet.</div>
        </div>
      </div>
    </div>
  </section>

  <script>
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn')
    const hackItems = document.querySelectorAll<HTMLElement>('.hack-item')
    const noResults = document.getElementById('no-results')

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.dataset.filter
        let visibleCount = 0

        filterButtons.forEach((item) => item.dataset.active = String(item === button))
        hackItems.forEach((item) => {
          const visible = filter === 'all' || item.dataset.difficulty === filter
          item.classList.toggle('hidden', !visible)
          if (visible) visibleCount += 1
        })
        noResults?.classList.toggle('hidden', visibleCount > 0)
      })
    })
  </script>
</Layout>
