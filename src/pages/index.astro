---
import Layout from '@/layouts/Layout.astro'
import { AppCard } from '@/components/app-card'
import { AppCount } from '@/components/app-count'
import { HackCard } from '@/components/hack-card'
import { OutlinedButton } from '@/components/outlined-button'
import { getCollection } from 'astro:content'
import { ArrowUpRight, BookOpen, Grid3x3, PlugZap } from 'lucide-react'
import { APP_CATALOG_PAGE_ENABLED } from '@/config/features'

const allHacks = await getCollection('hacks')
const allApps = await getCollection('apps')
const featuredHacks = allHacks
  .filter((hack) => typeof hack.data.featured === 'number' && hack.data.featured >= 1 && hack.data.featured <= 3)
  .sort((left, right) => (left.data.featured ?? 0) - (right.data.featured ?? 0))
  .slice(0, 3)
const preloadedApps = allApps.filter((app) => app.data.preloaded)
---

<Layout title="Badger / 2026 Field Guide" description="A living field guide to apps, hacks, and hardware workflows for the Badger 2350.">
  <section class="relative overflow-hidden border-b border-border/70 py-20 sm:py-28">
    <div class="grid-texture pointer-events-none absolute inset-0 opacity-35"></div>
    <div class="container relative">
      <div class="grid items-center gap-14 lg:grid-cols-[1.05fr_0.95fr]">
        <div class="max-w-2xl space-y-8">
          <div class="space-y-5">
            <h1 class="max-w-xl text-5xl leading-[0.98] sm:text-7xl">
              Hack. Tinker. <span class="text-primary">Repeat.</span>
            </h1>
            <p class="max-w-xl text-base leading-7 text-muted-foreground sm:text-lg">
              Apps, hacks, and hardware notes for the Badger 2350.
            </p>
          </div>

          <div class="flex flex-wrap gap-3">
            {APP_CATALOG_PAGE_ENABLED && (
              <a href="/apps" class="inline-flex h-11 items-center gap-2 rounded-md bg-primary px-5 font-mono text-sm text-primary-foreground transition-colors hover:bg-primary/85">
                Browse apps
                <Grid3x3 className="h-4 w-4" />
              </a>
            )}
            <a href="/edit" class="inline-flex h-11 items-center gap-2 rounded-md border border-border/90 px-5 font-mono text-sm transition-colors hover:border-primary/60 hover:text-primary">
              Edit a badge
              <PlugZap className="h-4 w-4" />
            </a>
          </div>

          <div class="grid max-w-lg grid-cols-3 gap-6 border-t border-border/70 pt-6">
            <div class="metric">
              <AppCount fallback={allApps.length} client:load />
              <div class="metric-label">apps</div>
            </div>
            <div class="metric">
              <div class="metric-value">{allHacks.length}</div>
              <div class="metric-label">hacks</div>
            </div>
            <div class="metric">
              <div class="metric-value">USB</div>
              <div class="metric-label">editor</div>
            </div>
          </div>
        </div>

        <div class="relative mx-auto w-full max-w-[28rem]">
          <div class="surface overflow-hidden p-2">
            <img src="/images/hero.jpg" alt="Badger 2350 hardware badge" class="aspect-square w-full rounded-lg object-cover" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-border/70 py-16">
    <div class="container">
      <div class="grid gap-6 md:grid-cols-2">
        <a href="/get-started" class="surface surface-hover group p-6">
          <h2 class="text-2xl">Get to first boot</h2>
          <span class="mt-6 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.14em] text-primary">Open guide <ArrowUpRight className="h-4 w-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" /></span>
        </a>
        <a href="/about-badge" class="surface surface-hover group p-6">
          <h2 class="text-2xl">Hardware map</h2>
          <span class="mt-6 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.14em] text-primary">View hardware <ArrowUpRight className="h-4 w-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" /></span>
        </a>
      </div>
    </div>
  </section>

  <section class="py-20 sm:py-24">
    <div class="container">
      <div class="mb-10 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
        <div class="section-heading">
          <h2 class="text-3xl sm:text-4xl">Apps</h2>
        </div>
        <OutlinedButton href="/edit" variant="subtle" client:load><span>Show more</span><PlugZap className="h-3.5 w-3.5" /></OutlinedButton>
      </div>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {preloadedApps.slice(0, 6).map((app) => (
          <AppCard title={app.data.title} description={app.data.description} icon={app.data.icon} category={app.data.category} preloaded={app.data.preloaded} customizable={app.data.customizable} slug={app.slug} client:load />
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-border/70 bg-muted/25 py-20 sm:py-24">
    <div class="container">
      <div class="mb-10 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
        <div class="section-heading">
          <h2 class="text-3xl sm:text-4xl">Hacks</h2>
        </div>
        <OutlinedButton href="/hacks" variant="subtle" client:load><span>All hacks</span><BookOpen className="h-3.5 w-3.5" /></OutlinedButton>
      </div>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {featuredHacks.map((hack) => (
          <HackCard title={hack.data.title} description={hack.data.description} difficulty={hack.data.difficulty} duration={hack.data.duration} thumbnail={hack.data.thumbnail} slug={hack.slug} client:load />
        ))}
      </div>
    </div>
  </section>
</Layout>
