---
import type { GetStaticPaths } from 'astro'
import { CONTACTS_PAGE_ENABLED } from '@/config/features'
import { sitePath } from '@/lib/site-path'

export const getStaticPaths = (() => {
  if (!CONTACTS_PAGE_ENABLED) return []

  return [{ params: { contacts: 'contacts' } }]
}) satisfies GetStaticPaths

const destination = sitePath('/contacts')
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(destination, Astro.site)} />
    <title>Contacts moved | Badger</title>
    <script is:inline define:vars={{ destination }}>
      window.location.replace(`${destination}${window.location.search}${window.location.hash}`)
    </script>
  </head>
  <body>
    <p>Contacts moved to <a href={destination}>/contacts</a>.</p>
  </body>
</html>
