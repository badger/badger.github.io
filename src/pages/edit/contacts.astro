---
import Layout from '@/layouts/Layout.astro'
import EditorTools from '@/components/editor-tools.astro'
import { ContactsEditor } from '@/components/contacts-editor'
---

<Layout title="Contacts Editor | Badger" description="Edit a Badger contact card and export collected contacts over Web Bluetooth.">
  <section class="py-14 sm:py-20">
    <div class="container">
      <EditorTools />
      <ContactsEditor client:only="react" />
    </div>
  </section>
</Layout>
