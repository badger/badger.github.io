---
import Layout from '@/layouts/Layout.astro'
import ListingHero from '@/components/listing-hero.astro'
import BuildGuidePanel from '@/components/build-guide-panel.astro'
import VSCodeGuide from '@/content/build-guides/02-vscode.mdx'
import CopilotAppGuide from '@/content/build-guides/01-copilot-app.mdx'
import CopilotCLIGuide from '@/content/build-guides/03-copilot-cli.mdx'
import MacVSCodeGuide from '@/content/build-guides/mac/02-vscode.mdx'
import MacCopilotAppGuide from '@/content/build-guides/mac/01-copilot-app.mdx'
import MacCopilotCLIGuide from '@/content/build-guides/mac/03-copilot-cli.mdx'

const platforms = [
  {
    id: 'windows',
    label: 'Windows',
    guides: [
      { title: 'Build with the GitHub Copilot App', Content: CopilotAppGuide },
      { title: 'Build with VS Code', Content: VSCodeGuide },
      { title: 'Build with GitHub Copilot CLI', Content: CopilotCLIGuide },
    ],
  },
  {
    id: 'mac',
    label: 'macOS',
    guides: [
      { title: 'Build with the GitHub Copilot App', Content: MacCopilotAppGuide },
      { title: 'Build with VS Code', Content: MacVSCodeGuide },
      { title: 'Build with GitHub Copilot CLI', Content: MacCopilotCLIGuide },
    ],
  },
]
---

<Layout title="Build" description="Build a badge app with Copilot on Windows or macOS. No coding experience needed.">
  <ListingHero
    title="Build"
    description="Choose your operating system and Copilot tool. Connect your badge, describe your idea, and let Copilot guide the build and testing."
  />
  <section class="container py-10 sm:py-14">
    <div class="platform-picker mx-auto max-w-4xl space-y-6">
      <div class="space-y-2">
        <label for="build-platform" class="block font-mono text-sm uppercase tracking-[0.12em]">
          Choose your operating system
        </label>
        <select
          id="build-platform"
          name="build-platform"
          aria-controls="guides-windows guides-mac"
          class="min-h-11 min-w-48 rounded-lg border border-border/60 bg-card px-4 py-2 font-mono text-base text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        >
          {platforms.map(({ id, label }) => <option value={id} selected={id === 'windows'}>{label}</option>)}
        </select>
      </div>
      {platforms.map(({ id, label, guides }) => (
        <section
          id={`guides-${id}`}
          data-platform={id}
          aria-label={`${label} build guides`}
          hidden={id !== 'windows'}
          class="space-y-3"
        >
          {guides.map(({ title, Content }) => (
            <BuildGuidePanel title={title}>
              <Content />
            </BuildGuidePanel>
          ))}
        </section>
      ))}
    </div>
  </section>
</Layout>

<script>
  const platformPicker = document.querySelector<HTMLSelectElement>('#build-platform')
  const guideSections = document.querySelectorAll<HTMLElement>('[data-platform]')

  const showSelectedPlatform = () => {
    if (!platformPicker) return
    guideSections.forEach((section) => {
      section.hidden = section.dataset.platform !== platformPicker.value
    })
  }

  const revealFragment = () => {
    let targetId: string
    try {
      targetId = decodeURIComponent(window.location.hash.slice(1))
    } catch {
      return
    }
    const target = document.getElementById(targetId)
    const section = target?.closest<HTMLElement>('[data-platform]')
    if (!platformPicker || !target || !section) return

    platformPicker.value = section.dataset.platform ?? 'windows'
    showSelectedPlatform()
    target.closest('details')?.setAttribute('open', '')
    target.scrollIntoView()
  }

  platformPicker?.addEventListener('change', showSelectedPlatform)
  window.addEventListener('hashchange', revealFragment)
  showSelectedPlatform()
  revealFragment()
</script>

<style>
  #build-platform {
    color-scheme: dark;
  }
</style>
