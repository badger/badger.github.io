---
import Layout from '@/layouts/Layout.astro'
import ListingHero from '@/components/listing-hero.astro'
import NavigationCard from '@/components/navigation-card.astro'
import { BookOpen, Code2, Laptop, MonitorPlay, Terminal } from 'lucide-react'

const buildPaths = [
  {
    id: 'copilot-app',
    href: '/build/app',
    title: 'Copilot App',
    description: 'Describe an app in the desktop app and copy it to a connected badge.',
    icon: Laptop,
  },
  {
    id: 'vscode',
    href: '/build/vscode',
    title: 'VS Code',
    description: 'Build locally with Copilot Chat and the prepared badge tools.',
    icon: Code2,
  },
  {
    id: 'copilot-cli',
    href: '/build/cli',
    title: 'Copilot CLI',
    description: 'Build from a local terminal using plain-language instructions.',
    icon: Terminal,
  },
  {
    href: 'https://github.com/crnicholson/badge-sim-extension',
    title: 'VS Code Extension',
    description: 'Write Python in VS Code with a live badge emulator alongside your code. See the repository for installation.',
    icon: Code2,
  },
  {
    href: '/simulator',
    title: 'Simulator',
    description: 'Run badge Python and test controls in the browser.',
    icon: MonitorPlay,
  },
  {
    href: '/hacks',
    title: 'Start From a Hack',
    description: 'Follow a prepared project and modify the result.',
    icon: BookOpen,
  },
]
---

<Layout title="Build" description="Build a badge app with Copilot on Windows or macOS. No coding experience needed.">
  <ListingHero
    title="Build"
    description="Choose a Copilot tool, test in the browser, or start from a hack. Each Copilot guide includes Windows and macOS instructions."
    compact
  />

  <section id="local-build-guides" class="scroll-mt-28 border-b border-border/70 py-10 sm:py-12">
    <div class="container">
      <div class="mb-6">
        <h2 class="text-3xl sm:text-4xl">Choose a build path</h2>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-muted-foreground sm:text-base">
          Build locally with Copilot, test in the browser, or begin with a prepared hack.
        </p>
      </div>
      <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-3">
        {buildPaths.map((path) => <NavigationCard {...path} />)}
      </div>
    </div>
  </section>

</Layout>

<script>
  import { legacyBuildGuidePath } from '@/lib/build-guide-navigation'

  const redirectLegacyGuide = () => {
    const path = legacyBuildGuidePath(window.location.hash)
    if (path) window.location.replace(`${path}${window.location.search}`)
  }

  window.addEventListener('hashchange', redirectLegacyGuide)
  redirectLegacyGuide()
</script>
