---
import '@/styles/globals.css'

const destination = '/simulator'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href="https://badger.github.io/simulator" />
    <title>Simulator moved | Badger</title>
    <script is:inline define:vars={{ destination }}>
      window.location.replace(`${destination}${window.location.search}${window.location.hash}`)
    </script>
  </head>
  <body>
    <p>Simulator moved to <a href="/simulator">/simulator</a>.</p>
  </body>
</html>
