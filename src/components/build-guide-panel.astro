---
interface Props {
  title: string
}

const { title } = Astro.props
---

<details class="group rounded-lg border border-border/60 bg-card/70 open:border-primary/40">
  <summary class="cursor-pointer list-none px-5 py-4 font-mono text-sm uppercase tracking-[0.08em] text-foreground outline-none transition-colors marker:hidden hover:text-primary focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-inset sm:px-6">
    <span class="flex items-center justify-between gap-4">
      {title}
      <span aria-hidden="true" class="text-primary transition-transform group-open:rotate-45">+</span>
    </span>
  </summary>
  <article class="prose prose-invert max-w-none border-t border-border/50 px-5 py-5 prose-headings:font-display prose-headings:tracking-tight prose-a:text-primary prose-code:text-primary prose-pre:border prose-pre:border-border/60 prose-pre:bg-background sm:px-6">
    <slot />
  </article>
</details>
