---
interface Props {
  title: string
  description: string
  iconSrc: string
  color: string
}

const { title, description, iconSrc, color } = Astro.props
---

<div class="surface flex items-start gap-4 p-4">
  <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg" style={{ backgroundColor: color }}>
    <img src={iconSrc} alt="" class="h-8 w-8" loading="lazy" />
  </div>
  <div class="min-w-0 flex-1">
    <h3 class="mb-1 font-sans text-base font-semibold normal-case tracking-tight">{title}</h3>
    <p class="text-sm leading-6 text-muted-foreground">{description}</p>
  </div>
</div>
