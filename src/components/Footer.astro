---
import { APP_CATALOG_PAGE_ENABLED } from '@/config/features'
---

<footer class="border-t border-border/80 bg-background/80">
  <div class="container py-12">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div class="max-w-xs">
        <div class="flex items-center gap-3">
          <img src="/favicon.svg" alt="" class="h-8 w-8" />
          <h2 class="font-display text-xl">Badger</h2>
        </div>
      </div>

      <div>
        <h3 class="mb-4 font-mono text-xs uppercase tracking-[0.16em] text-foreground">Guides</h3>
        <ul class="space-y-2 text-sm text-muted-foreground">
          <li><a href="/get-started" class="transition-colors hover:text-primary">Get started</a></li>
          {APP_CATALOG_PAGE_ENABLED && <li><a href="/apps" class="transition-colors hover:text-primary">Browse apps</a></li>}
          <li><a href="/hacks" class="transition-colors hover:text-primary">Browse hacks</a></li>
        </ul>
      </div>

      <div>
        <h3 class="mb-4 font-mono text-xs uppercase tracking-[0.16em] text-foreground">Tools</h3>
        <ul class="space-y-2 text-sm text-muted-foreground">
          <li><a href="/about-badge" class="transition-colors hover:text-primary">Hardware map</a></li>
          <li><a href="/edit" class="transition-colors hover:text-primary">USB and disk editor</a></li>
          <li><a href="/edit/bluetooth" class="transition-colors hover:text-primary">Bluetooth editor</a></li>
          <li><a href="/contacts" class="transition-colors hover:text-primary">Contacts</a></li>
          <li><a href="https://github.com/badger/home" target="_blank" rel="noopener" class="transition-colors hover:text-primary">Firmware repo</a></li>
        </ul>
      </div>

      <div>
        <h3 class="mb-4 font-mono text-xs uppercase tracking-[0.16em] text-foreground">Community</h3>
        <ul class="space-y-2 text-sm text-muted-foreground">
          <li><a href="https://github.com/badger/badger.github.io" target="_blank" rel="noopener" class="transition-colors hover:text-primary">Site source</a></li>
          <li><a href="https://github.com/badger/badger.github.io/discussions" target="_blank" rel="noopener" class="transition-colors hover:text-primary">Discussions</a></li>
        </ul>
      </div>
    </div>
  </div>
</footer>
