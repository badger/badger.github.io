---
import { RotateCcw } from 'lucide-react'
---

<div data-doom-video-toolbar hidden class="mt-3 text-center">
  <button type="button" data-doom-video-close class="doom-link"><RotateCcw size={14} aria-hidden="true" />Return to Doom</button>
  <a class="ml-3 font-mono text-xs text-primary hover:underline" href="https://www.youtube.com/watch?v=dQw4w9WgXcQ" target="_blank" rel="noopener noreferrer">Open on YouTube<span class="sr-only"> (opens in a new tab)</span></a>
</div>

<style>
  .doom-link { display: inline-flex; align-items: center; justify-content: center; gap: 0.625rem; min-height: 2.25rem; padding: 0.5rem 0.625rem; border: 1px solid hsl(var(--border) / 0.4); border-radius: 0.375rem; font-family: var(--font-mono, ui-monospace, monospace); font-size: 0.6875rem; transition: border-color 150ms, background-color 150ms; }
  .doom-link:hover { border-color: hsl(var(--primary) / 0.5); background: hsl(var(--primary) / 0.05); }
  .doom-link:focus-visible { outline: 2px solid hsl(var(--primary)); outline-offset: 2px; }
</style>
