---
import { OutlinedButton } from './outlined-button'

interface Action {
  label: string
  href: string
  icon?: any
  variant?: 'solid' | 'outline'
  external?: boolean
}

interface Props {
  title: string
  titleHighlight?: string
  description?: string
  actions?: Action[]
}

const { title, titleHighlight, description, actions = [] } = Astro.props as Props
---

<section class="relative overflow-hidden border-b border-border/70 py-20 sm:py-24">
  <div class="grid-texture pointer-events-none absolute inset-0 opacity-30"></div>
  <div class="container relative">
    <div class="max-w-3xl space-y-6">
      <h1 class="max-w-2xl text-5xl leading-[0.98] sm:text-6xl">
        {title}
        {titleHighlight && <span class="text-primary"> {titleHighlight}</span>}
      </h1>
      {description && <p class="max-w-2xl text-base leading-7 text-muted-foreground sm:text-lg">{description}</p>}
      {actions.length > 0 && (
        <div class="flex flex-wrap gap-3 pt-2">
          {actions.map((action) => {
            const Icon = action.icon
            if (action.variant === 'solid') {
              return (
                <a href={action.href} target={action.external ? '_blank' : undefined} rel={action.external ? 'noreferrer noopener' : undefined} class="inline-flex h-11 items-center gap-2 rounded-md bg-primary px-5 font-mono text-sm text-primary-foreground outline-none transition-colors hover:bg-primary/85 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background">
                    {Icon && <Icon className="h-4 w-4" />}
                    {action.label}
                </a>
              )
            }
            return (
              <OutlinedButton href={action.href} client:load>
                {Icon && <Icon className="h-4 w-4" />}
                {action.label}
              </OutlinedButton>
            )
          })}
        </div>
      )}
    </div>
  </div>
</section>
