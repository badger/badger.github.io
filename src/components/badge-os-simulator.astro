---
import BadgeImage from '@/components/badge-image.astro'

const badgeButtons = [
  { label: 'A', name: 'Left', bit: 16 },
  { label: 'B', name: 'Right', bit: 8 },
  { label: 'C', name: 'Select', bit: 4 },
]
const sideButtons = [
  { label: '↑', name: 'Up', bit: 2 },
  { label: '↓', name: 'Down', bit: 1 },
  { label: '⌂', name: 'Home', bit: 32 },
]
const keymap = [
  ['← →', 'A / B'],
  ['↑ ↓', 'Up / Down'],
  ['Space / Enter', 'C select'],
  ['Esc', 'Home'],
]
---

<div id="badge-os-simulator" data-state="fallback">
  <div data-fallback>
    <BadgeImage />
  </div>
  <figure data-simulator hidden class="rounded-lg border border-border/40 bg-card p-4 sm:p-6">
    <div class="grid gap-6 lg:grid-cols-[minmax(0,640px)_15rem] lg:items-center lg:justify-center lg:gap-10">
      <div class="mx-auto w-full max-w-[640px] rounded-lg border border-border/40 bg-black p-2 sm:p-3">
        <canvas
          width="320"
          height="240"
          tabindex="0"
          aria-label="Simulated badge display running the BadgeOS menu. Focus the display, then use arrow keys to move, Space to select, and Escape for Home."
          class="badge-os-screen block aspect-[4/3] h-auto w-full"
        ></canvas>
      </div>
      <div class="grid gap-5">
        <p data-status class="font-mono text-xs uppercase tracking-[0.12em] text-primary" aria-live="polite">Booting</p>
        <div class="grid gap-2">
          <span class="font-mono text-xs uppercase tracking-[0.12em] text-muted-foreground">Front</span>
          <div class="flex gap-2">
            {badgeButtons.map(({ label, name, bit }) => (
              <button type="button" class="badge-os-key font-mono text-foreground" data-button={bit} aria-label={`Badge button ${label} (${name})`}>{label}</button>
            ))}
          </div>
        </div>
        <div class="grid gap-2">
          <span class="font-mono text-xs uppercase tracking-[0.12em] text-muted-foreground">Side</span>
          <div class="flex gap-2">
            {sideButtons.map(({ label, name, bit }) => (
              <button type="button" class="badge-os-key font-mono text-foreground" data-button={bit} aria-label={`Badge ${name} button`}>{label}</button>
            ))}
          </div>
        </div>
        <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 font-mono text-xs text-muted-foreground">
          {keymap.map(([key, action]) => (
            <>
              <dt class="text-foreground">{key}</dt>
              <dd>{action}</dd>
            </>
          ))}
        </dl>
      </div>
    </div>
    <figcaption class="mx-auto max-w-prose pt-4 text-center text-sm text-muted-foreground">
      BadgeOS menu and stock apps running in a MicroPython WebAssembly simulator. Select an app with C; press Home to return to the menu. Wi-Fi and sensors need the physical badge.
    </figcaption>
  </figure>
</div>

<style>
  .badge-os-screen { image-rendering: pixelated; transition: opacity 150ms; }
  .badge-os-screen:focus-visible { outline: 2px solid hsl(var(--primary)); outline-offset: 3px; }
  .badge-os-key { width: 2.75rem; height: 2.25rem; border: 1px solid hsl(var(--border) / 0.4); border-radius: 0.375rem; background: transparent; font-size: 0.8rem; touch-action: none; user-select: none; transition: border-color 150ms, background-color 150ms; }
  .badge-os-key:hover { border-color: hsl(var(--primary) / 0.5); background: hsl(var(--primary) / 0.05); }
  .badge-os-key:focus-visible { outline: 2px solid hsl(var(--primary)); outline-offset: 2px; }
  .badge-os-key[data-pressed='true'] { color: hsl(var(--primary)); border-color: hsl(var(--primary)); background: hsl(var(--primary) / 0.1); transform: translateY(1px); box-shadow: inset 0 1px 3px rgb(0 0 0 / 0.6); }
</style>

<script>
  import { initBadgeOsSimulator } from '@/lib/badge-os-simulator-view'

  const root = document.getElementById('badge-os-simulator')
  if (root) initBadgeOsSimulator(root)
</script>
