---
import { Maximize, Minus, Plus, RotateCw, ScanSearch } from 'lucide-react'
import BadgeImage from '@/components/badge-image.astro'

const badgeButtons = [
  { label: 'A', name: 'Left', bit: 16 },
  { label: 'B', name: 'Right', bit: 8 },
  { label: 'C', name: 'Select', bit: 4 },
]
const sideButtons = [
  { label: '↑', name: 'Up', bit: 2 },
  { label: '↓', name: 'Down', bit: 1 },
  { label: '⌂', name: 'Home', bit: 32 },
]
---

<div id="badge-os-simulator" data-state="fallback" class="badge-os-stack">
  <div data-fallback>
    <BadgeImage />
  </div>
  <figure data-simulator class="rounded-lg border border-border/40 bg-card p-4 sm:p-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <p data-status class="font-mono text-xs uppercase tracking-[0.12em] text-primary" aria-live="polite">Booting</p>
      <div class="flex flex-wrap items-center gap-2">
        <button type="button" data-model-screen class="badge-os-key badge-os-tool font-mono text-foreground" aria-pressed="false" title="Zoom to the screen" disabled><ScanSearch size={14} />Screen</button>
        <button type="button" data-model-full class="badge-os-key badge-os-tool font-mono text-foreground" aria-pressed="true" title="Show the whole badge" disabled><Maximize size={14} />Full</button>
        <button type="button" data-model-rotate class="badge-os-key badge-os-tool font-mono text-foreground" aria-pressed="false" title="Turn the badge upside down"><RotateCw size={14} />Rotate</button>
      </div>
    </div>
    <div data-model class="badge-os-model">
      <canvas data-screen width="320" height="240" hidden></canvas>
      <p data-model-status hidden></p>
      <div class="badge-os-zoom" role="group" aria-label="Zoom">
        <button type="button" data-model-zoom-in class="badge-os-key grid place-items-center bg-background/80 text-foreground" aria-label="Zoom in" title="Zoom in" disabled><Plus size={14} /></button>
        <button type="button" data-model-zoom-out class="badge-os-key grid place-items-center bg-background/80 text-foreground" aria-label="Zoom out" title="Zoom out" disabled><Minus size={14} /></button>
      </div>
    </div>
    <div class="mx-auto flex max-w-[420px] flex-wrap items-center justify-between gap-4" role="group" aria-label="Badge controls">
      <div class="flex gap-2">
        {badgeButtons.map(({ label, name, bit }) => (
          <button type="button" class="badge-os-key font-mono text-foreground" data-button={bit} aria-label={`Badge button ${label} (${name})`}>{label}</button>
        ))}
      </div>
      <div class="flex gap-2">
        {sideButtons.map(({ label, name, bit }) => (
          <button type="button" class="badge-os-key font-mono text-foreground" data-button={bit} aria-label={`Badge ${name} button`}>{label}</button>
        ))}
      </div>
    </div>
    <p class="mt-3 text-center font-mono text-[0.7rem] text-muted-foreground">
      Click the badge, then: arrows move · Space selects · Esc Home · tap the printed pads · drag rotates · scroll or +/− zooms · Rotate turns the badge upside down · tilt a device with motion sensors ·
      <a href="https://leereilly.net/h4x0r3d-badge/#hardware" target="_blank" rel="noreferrer" class="hover:text-foreground">model source ↗</a>
    </p>
    <figcaption class="mx-auto max-w-prose pt-3 text-center text-sm text-muted-foreground">
      Mona OS 4.0 menu and stock apps running in a MicroPython WebAssembly simulator. Select an app with C; press Home to return to the menu. Wi-Fi reports connected and HTTP requests go through the browser, subject to CORS. Socket apps such as Camera and Copilot need the physical badge.
    </figcaption>
  </figure>
</div>

<style>
  .badge-os-stack { position: relative; }
  .badge-os-stack[data-state='fallback'] > [data-simulator] { display: none; }
  .badge-os-stack[data-state='loading'] > [data-simulator] { position: absolute; inset: 0 0 auto 0; visibility: hidden; pointer-events: none; }
  .badge-os-stack[data-state='running'] > [data-fallback] { display: none; }
  .badge-os-model { position: relative; width: 100%; height: clamp(340px, 60vh, 600px); overflow: hidden; }
  .badge-os-model :global(canvas:not([data-screen])) { display: block; width: 100%; height: 100%; touch-action: none; outline: none; }
  .badge-os-model :global(canvas:not([data-screen]):focus-visible) { outline: 2px solid hsl(var(--primary)); outline-offset: -2px; }
  .badge-os-zoom { position: absolute; right: 0.5rem; bottom: 0.5rem; display: flex; flex-direction: column; gap: 0.375rem; }
  .badge-os-key { width: 2.75rem; height: 2.25rem; border: 1px solid hsl(var(--border) / 0.4); border-radius: 0.375rem; background: transparent; font-size: 0.8rem; touch-action: none; user-select: none; transition: border-color 150ms, background-color 150ms; }
  .badge-os-key:hover:not(:disabled) { border-color: hsl(var(--primary) / 0.5); background: hsl(var(--primary) / 0.05); }
  .badge-os-key:disabled { opacity: 0.4; }
  .badge-os-key:focus-visible { outline: 2px solid hsl(var(--primary)); outline-offset: 2px; }
  .badge-os-key[data-pressed='true'] { color: hsl(var(--primary)); border-color: hsl(var(--primary)); background: hsl(var(--primary) / 0.1); transform: translateY(1px); box-shadow: inset 0 1px 3px rgb(0 0 0 / 0.6); }
  .badge-os-tool { display: inline-flex; width: auto; align-items: center; gap: 0.5rem; padding: 0 0.75rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.12em; }
  .badge-os-tool[aria-pressed='true'] { color: hsl(var(--primary)); border-color: hsl(var(--primary) / 0.6); }
  @media (max-width: 480px) { .badge-os-tool { padding: 0 0.5rem; letter-spacing: 0.08em; } }
</style>

<script>
  import { initBadgeOsSimulator } from '@/lib/badge-os-simulator-view'

  const root = document.getElementById('badge-os-simulator')
  if (root) initBadgeOsSimulator(root)
</script>
