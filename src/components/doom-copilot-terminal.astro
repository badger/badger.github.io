---
import { sitePath } from '@/lib/site-path'
---

<div data-doom-terminal hidden role="region" aria-labelledby="doom-terminal-title" tabindex="0">
  <div class="terminal-body" data-terminal-scroll>
    <div class="terminal-welcome">
      <img class="copilot-mark" src={sitePath('/images/copilot-cli.png')} width="96" height="90" alt="" />
      <h2 id="doom-terminal-title">Made with Copilot</h2>
    </div>
    <p class="terminal-prompt"><span aria-hidden="true">&gt;</span> <span data-terminal-prompt></span><span data-terminal-caret aria-hidden="true" class="terminal-caret"></span></p>
    <p data-terminal-status role="status" class="terminal-status"></p>
    <pre data-terminal-output aria-hidden="true"></pre>
    <div data-terminal-transcript class="sr-only" hidden></div>
    <p data-terminal-hint hidden class="terminal-hint">
      Click the middle badge button below for more info
      <span aria-hidden="true">v</span>
    </p>
  </div>
</div>

<style>
  [data-doom-terminal] { position: absolute; inset: 0; color: hsl(var(--foreground)); background: hsl(var(--background)); font-family: var(--font-mono, ui-monospace, monospace); }
  [data-doom-terminal]:focus-visible { outline: 2px solid hsl(var(--primary)); outline-offset: -2px; }
  .terminal-body { height: 100%; overflow-y: auto; padding: 24px; scrollbar-width: thin; }
  .terminal-welcome { display: flex; align-items: center; gap: 24px; margin-bottom: 24px; }
  .copilot-mark { width: 96px; height: 90px; flex-shrink: 0; }
  h2 { font: inherit; font-size: 26px; color: hsl(var(--muted-foreground)); }
  .terminal-prompt { min-height: 3em; font-size: 18px; }
  .terminal-prompt > span:first-child { color: hsl(var(--primary)); }
  .terminal-caret { display: inline-block; width: 0.55em; height: 1.1em; margin-left: 0.15em; background: hsl(var(--primary)); vertical-align: -0.15em; }
  .terminal-caret[hidden] { display: none; }
  .terminal-status { min-height: 1.5em; margin: 12px 0; color: hsl(var(--muted-foreground)); font-size: 16px; }
  pre { margin: 0; padding: 0; border: 0; background: transparent; white-space: pre-wrap; overflow-wrap: anywhere; font: inherit; font-size: 18px; line-height: 1.6; }
  .terminal-hint { margin-top: 24px; text-align: center; color: hsl(var(--primary)); font-size: 16px; }
  .terminal-hint span { display: block; margin-top: 8px; }
</style>
